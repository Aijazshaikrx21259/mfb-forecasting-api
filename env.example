# Deployment environment: set to 'production' to enforce strict CORS.
ENVIRONMENT=local

# API key required in the X-API-Key header to access endpoints and docs.
API_KEY=change-me

# Comma separated list of allowed origins for CORS (required in production).
ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000

# Postgres connection string used by the FastAPI service for data-quality endpoints.
DATABASE_URL=postgresql://user:password@host/dbname

# Automatic forecasting pipeline (optional)
# Enable to run build -> train-select -> forecast on a fixed cadence.
# PIPELINE_AUTO_RUN=true
# PIPELINE_INITIAL_DELAY_SECONDS=60
# PIPELINE_INTERVAL_MINUTES=1440

# Trigger the forecasting pipeline automatically when plan/forecast endpoints
# are requested and no run exists yet (defaults to true).
# PIPELINE_RUN_ON_DEMAND=true
